{
    "name": "visualbuilder/filament-lottie",
    "description": "Lottie animation Schema component and Blade component for Filament panels.",
    "keywords": [
        "visualbuilder",
        "lottie",
        "animation",
        "filament",
        "schema",
        "component"
    ],
    "homepage": "https://github.com/visualbuilder/filament-lottie",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Visual Builder",
            "email": "support@ekouk.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Visualbuilder\\Lottie\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Visualbuilder\\Lottie\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Visualbuilder\\Lottie\\LottieServiceProvider"
            ]
        },
        "branch-alias": {
            "5.x-dev": "5.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
